# Example configuration for local/dev usage.
# Copy to config.yaml and replace sensitive values via environment variables.

app:
  name: "monetics"
  version: "1.0.0"
  environment: "production" # development, staging, production
  port: 8080

database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "change_me" # Set via DB_PASSWORD env var
  name: "monetics_database" # Set via DB_NAME env var
  ssl_mode: "disable"

jwt:
  secret: "change_me" # REQUIRED: Set via JWT_SECRET env var
  expiry_hour: 24

logger:
  level: "debug" # debug, info, warn, error, fatal
  format: "console" # json, console

admin:
  username: "admin" # Set via ADMIN_USERNAME env var
  password: "change_me" # Set via ADMIN_PASSWORD env var

# AI-assisted features (smart CSV import categorization).
# Disabled by default. To enable, set AI_ENABLED=true and provide AI_API_KEY.
ai:
  enabled: false              # AI_ENABLED
  provider: "openai"          # AI_PROVIDER (only "openai" is supported today)
  api_key: ""                 # AI_API_KEY — REQUIRED when enabled. Never commit real keys.
  model: "gpt-4o-mini"        # AI_MODEL
  base_url: "https://api.openai.com/v1" # AI_BASE_URL (override for proxies/Azure OpenAI compatible endpoints)
  timeout_seconds: 60         # AI_TIMEOUT_SECONDS — HTTP timeout per request
  max_items_per_request: 500  # AI_MAX_ITEMS_PER_REQUEST — hard cap on transactions per suggest call
  min_confidence: 0.4         # AI_MIN_CONFIDENCE — suggestions below this become category_id=0
  history_lookback_days: 90   # AI_HISTORY_LOOKBACK_DAYS — window of past transactions used as few-shot examples
  history_max_examples: 20    # AI_HISTORY_MAX_EXAMPLES — max examples included in the prompt
  rate_limit_per_minute: 10   # AI_RATE_LIMIT_PER_MINUTE — per-user soft cap (reserved for future use)
